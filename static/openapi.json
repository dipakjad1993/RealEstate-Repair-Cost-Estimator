            "title": "List Price"
          },
          "sqft": {
            "default": 1500,
            "title": "Sqft",
            "type": "number"
          },
          "state": {
            "default": "",
            "maxLength": 2,
            "title": "State",
            "type": "string"
          },
          "year_built": {
            "default": 1995,
            "title": "Year Built",
            "type": "integer"
          },
          "zip_code": {
            "default": "",
            "title": "Zip Code",
            "type": "string"
          }

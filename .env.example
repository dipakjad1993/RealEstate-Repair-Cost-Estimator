# Copy to .env (never commit .env)
CENSUS_API_KEY=
BLS_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ATTCOM_API_KEY=
RENTCAST_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
WHISPER_BACKEND=none
API_KEY=
APP_BASE_URL=http://localhost:8501
# --- Security (v3.4 REQUIRED for share links; generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
SHARE_SECRET=
SHARE_SECRET_PREVIOUS=
# --- Distributed rate limiting (optional; in-memory fallback) ---
REDIS_URL=
# --- FRED macro anchors (free key: https://fred.stlouisfed.org/docs/api/api_key.html) ---
FRED_API_KEY=
# --- Audit log location (default data/audit_log.jsonl) ---
AUDIT_LOG_PATH=
# --- Snapshot dir for ETL layer (default data/snapshots) ---
SNAPSHOT_DIR=
# --- Dev-only escape hatches (never set in prod) ---
API_AUTH_DISABLED=
ALLOW_INSECURE_SHARE=
# --- OpenTelemetry (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
